# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Seed script
ADMIN_EMAIL=studio@example.com
ADMIN_PASSWORD=change-me-admin-password
DEMO_CUSTOMER_EMAIL=customer@example.com
DEMO_CUSTOMER_PASSWORD=change-me-customer-password
